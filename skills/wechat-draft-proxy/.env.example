# 微信公众号草稿代理客户端配置
# 使用方式：cp .env.example .env 然后编辑填写真实值
#
# 脚本会自动从同目录 .env 加载（仅当对应环境变量未设置时）
# 优先级：命令行 --server/--api-key > .env 文件 > 环境变量

# 代理服务器地址（必填）
WECHAT_PROXY_URL=https://your-proxy-server.example.com

# 代理服务器 API Key（必填，服务端 PROXY_API_KEY 的对应值）
WECHAT_PROXY_API_KEY=请替换为你的长随机字符串

# 可选：如需强制指定端口等可在此扩展
# WECHAT_PROXY_PORT=443
