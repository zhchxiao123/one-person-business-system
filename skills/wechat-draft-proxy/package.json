{
  "name": "wechat-draft-proxy",
  "version": "2.2.0",
  "description": "微信公众号草稿箱 + 视频一站式发布（Node.js 版） - 通过固定 IP 代理服务器发布到微信公众号 + 视频号，无需客户端配置微信 IP 白名单",
  "main": "scripts/create_draft.js",
  "bin": {
    "wechat-draft": "./scripts/create_draft.js"
  },
  "scripts": {
    "start": "node scripts/create_draft.js",
    "draft": "node scripts/create_draft.js",
    "upload-video": "python3 scripts/upload_video.py",
    "send-video": "python3 scripts/send_video.py"
  },
  "keywords": [
    "wechat",
    "微信公众号",
    "draft",
    "草稿箱",
    "proxy",
    "公众号发布",
    "video",
    "视频素材",
    "mpvideo",
    "视频号"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "commonjs"
}
